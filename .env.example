# Salin ke .env lalu isi. JANGAN commit file .env (sudah ada di .gitignore).

# Password akun "admin" saat database pertama kali dibuat (minimal 12 karakter).
CMS_ADMIN_PASSWORD=ganti-dengan-password-kuat

# Port di komputer/server untuk membuka aplikasi langsung (bawaan 8080, hanya localhost).
DCMS_PORT=8080
DCMS_BIND=127.0.0.1

# --- Hanya untuk produksi dengan HTTPS (docker compose --profile https up -d) ---
# DCMS_DOMAIN=contoh.id
# CMS_SITE_URL=https://contoh.id
# CMS_TRUST_PROXY=1
